{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["slug", "name", "github"],
    "additionalProperties": false,
    "properties": {
      "slug":        { "type": "string", "minLength": 1 },
      "name":        { "type": "string", "minLength": 1 },
      "description": { "type": "string" },
      "github":      { "type": ["string", "null"] },
      "install": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "npm":   { "type": "string" },
          "pip":   { "type": "string" },
          "brew":  { "type": "string" },
          "cargo": { "type": "string" }
        }
      }
    }
  }
}
